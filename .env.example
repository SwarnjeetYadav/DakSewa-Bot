# Create a bot with Telegram's official @BotFather and put the token here.
TELEGRAM_BOT_TOKEN=replace_with_your_telegram_bot_token

# Official India Post website (tracking form is hosted here).
INDIA_POST_TRACK_URL=https://www.indiapost.gov.in/

# Optional tuning
PAGE_TIMEOUT_MS=30000
MAX_CAPTCHA_ATTEMPTS=5
